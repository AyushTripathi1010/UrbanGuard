# Copy this file to .env and fill in real values. .env is gitignored.

# --- kafka ---
KAFKA_BOOTSTRAP_SERVERS=localhost:9092
KAFKA_GROUP_DETECT=urbanguard-detect
KAFKA_GROUP_AGENTS=urbanguard-agents
KAFKA_GROUP_RL=urbanguard-rl-feedback
KAFKA_TOPIC_RAW_FRAMES=raw-frames
KAFKA_TOPIC_ALERTS=alerts
KAFKA_TOPIC_RL_FEEDBACK=rl-feedback

# --- postgres ---
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=urbanguard
POSTGRES_PASSWORD=urbanguard
POSTGRES_DB=urbanguard

# --- redis ---
REDIS_URL=redis://localhost:6379/0

# --- minio (s3-compatible) ---
MINIO_ENDPOINT=http://localhost:9000
MINIO_ACCESS_KEY=urbanguard
MINIO_SECRET_KEY=urbanguardminio
MINIO_BUCKET_FRAMES=frames

# --- llm providers ---
LLM_PRIMARY=gemini
LLM_FALLBACK=groq
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
GROQ_API_KEY=
GROQ_MODEL=llama-3.1-8b-instant

# --- langfuse (self-hosted) ---
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=http://localhost:3001

# --- routing ---
OSRM_BASE_URL=http://localhost:5000

# --- mlflow + dvc (dagshub) ---
MLFLOW_TRACKING_URI=
MLFLOW_TRACKING_USERNAME=
MLFLOW_TRACKING_PASSWORD=

# --- detection ---
DETECT_DEVICE=mps
CLIP_MODEL=ViT-B-32
CLIP_PRETRAINED=laion2b_s34b_b79k
CLIP_ACCIDENT_THRESHOLD=0.35
RESNET_CHECKPOINT=data/checkpoints/resnet50_severity.pt
RESNET_SEVERITY_THRESHOLD=0.5

# --- ingest ---
INGEST_TARGET_FPS=2
INGEST_DATA_DIR=data/raw

# --- service ports ---
GATEWAY_PORT=8000
INGEST_PORT=8001
DETECT_PORT=8002
AGENTS_PORT=8004
RL_POLICY_PORT=8005
